---
import Paragraph from "../shared/Paragraph.astro";
import Image from "../common/Image.astro";
export interface Props {
  title: string;
  features: string[];
  icon: ImageMetadata;
  dataTranslate: string
}

const { title, features, icon, dataTranslate } = Astro.props;
---

<div
  class="p-5 sm:p-6 lg:p-8 relative overflow-hidden rounded-3xl shadow-md shadow-slate-700 dark:shadow-slate-900
  bg-gradient-to-tr from-slate-100/70 to-zinc-200/60 dark:from-slate-800/10 dark:to-zinc-800/10 backdrop-blur-md
  transition-transform duration-300 ease-out hover:scale-105 hover:shadow-lg hover:shadow-slate-500/50 hover:dark:shadow-slate-900/50
  hover:bg-gradient-to-br hover:from-slate-200 hover:to-zinc-300 dark:hover:from-slate-700 dark:hover:to-zinc-800"
>
  <div class="flex items-center space-x-4">
    <div class="w-12 h-12 rounded-full border-4 border-gray-300 flex items-center justify-center bg-white overflow-hidden">
      <Image src={icon} alt={title} class="w-full h-full object-contain" />
    </div>
    <div>
      <h2 class="text-lg md:text-xl font-semibold text-heading-2" data-translate={title}>
        {title}
      </h2>
    </div>
  </div>

  <Paragraph>
    <div
      class="mt-8 space-y-4 text-heading-3 font-medium list-outside list-disc"
    >
      {
        features.map((feature) => {
          return (
            <div class="flex items-center font-medium">
              <span class="font-bold rounded-full w-8 h-8 mr-3 inline-flex justify-center items-center text-primary dark:text-white
                bg-gray-300 dark:bg-gray-700 transition-colors duration-300 hover:bg-primary hover:text-white dark:hover:bg-primary/80">
                &checkmark; 
              </span>
              <p data-translate={feature}></p>
            </div>
          );
        })
      }
    </div>
  </Paragraph>

  <!-- Brillo sutil en hover -->
  <span
    class="absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full transition-all duration-300 ease-out
    hover:w-40 hover:opacity-80"
  ></span>
</div>

  <!-- <span
    class="absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full"
  ></span> -->
</div>
