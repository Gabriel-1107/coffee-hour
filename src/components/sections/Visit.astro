---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import reloj from "../../assets/images/reloj.webp"
import ubicacion from "../../assets/images/ubicacion.webp"
---

<section class=`relative pt-32 lg:pt-36`>
    <Container className="space-y-10 md:sapce-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-4">
        <Title className="space-y-10 md:space-y-12 mb-10" dataTranslate="VISIT">Visítanos</Title>
        <!-- Contenedor del mapa y detalles -->
       <div class="section row pb-0 mt" >
        <!-- Mapa de Google Maps -->
        <iframe
        class="w-full max-w-[1200px] h-80 md:h-96 rounded-lg shadow-lg mx-auto"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3742.3094515698035!2d-103.19349952452926!3d20.287454481182795!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842f40b99eed4a5b%3A0xa50e2a5d5a4d56d4!2sCoffee%20Hour!5e0!3m2!1ses!2smx!4v1743034161817!5m2!1ses!2smx"
        allowfullscreen=""
        loading="lazy"
        style="border: 0;"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      
       </div>  
        <Fragment>
          <div style="margin-top: 30px; display: flex; gap: 20px; justify-content: center; align-items: flex-start;">
                <!-- Columna izquierda -->
                <div style="flex: 1; text-align: center;">
                  <!-- Imagen -->
                <div><img src={reloj.src} alt="Imagen" width="100" height="100" style="display: block; margin: 0 auto 15px;"></div>
              
                  <!-- Subtítulo en negritas -->
                  <p class="dark:text-white" style="font-weight: bold; margin-bottom: 10px;" data-translate="horario">Horario</p>
              
                  <!-- Lista de frases -->
                  <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li class="dark:text-white" data-translate="horachapala1">Lunes - Domingo 8a.m - 9:30p.m</li>                
                  </ul>
                </div>
              
                <!-- Columna derecha -->
                <div style="flex: 1; text-align: center;">
                  <!-- Imagen -->
                  <div><img src={ubicacion.src} alt="Imagen" width="100" height="100" style="display: block; margin: 0 auto 15px;"></div>
              
                  <!-- Subtítulo en negritas -->
                  <p style="font-weight: bold; margin-bottom: 10px;"  class="dark:text-white" data-translate="ubicacion">Localización</p>
              
                  <!-- Lista de frases -->
                  <ul style="list-style-type: none; margin: 0; padding: 0;">
                    <li class="dark:text-white" data-translate="ubichapala1">P.º Ramón Corona 11- A, Chapala Centro, 45900 Chapala, Jal.</li>
                  </ul>
                </div>
          </div>     
        </Fragment>
    <Container/>
</section>