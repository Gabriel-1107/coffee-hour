---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
---

<section class="relative pt-32 lg:pt-36">
  <Container>
    <Title className="space-y-10 md:space-y-12 mb-10 text-center">
      Testimonios
      <p class="text-xl">Conoce la opinión de nuestros clientes</p>
    </Title>

    <div class="testimonials-container">
      {[
        { name: "Juan Antonio López Martínez", image: "../../src/assets/images/avatar2.gif", message: "Excelente lugar para comer y pasar un rato agradable con amigos y/o pareja." },
        { name: "María Zúñiga", image: "../../src/assets/images/avatar5.gif", message: "Muy bien! Buen servicio, buena comida." },
        { name: "Iván Aguilar", image: "../../src/assets/images/avatar4.gif", message: "Buena calidad de comida, buen servicio, recibe tarjeta de crédito y facturan." },
        { name: "Deyhanira Vasallo", image: "../../src/assets/images/avatar1.gif", message: "Excelente atención, el café delicioso, un lugar muy agradable." },
        { name: "Juan Mendoza", image: "../../src/assets/images/avatar3.gif", message: "Excelente servicio y atención. Tienen wifi y se puede trabajar agusto" },
        { name: "Guadalupe López", image: "../../src/assets/images/avatar6.gif", message: "Delicioso café y excelente servicio." }
      ].map((testimonial, index) => (
        <div class="card">
          <div class="header">
            <img src={testimonial.image} alt={testimonial.name} class="image" />
            <div>
              <div class="stars">
                {[...Array(5)].map((_, i) => (
                  <svg  fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                ))}
              </div>
              <p class="name dark:text-white">{testimonial.name}</p>
            </div>
          </div>
          <p class="message dark:text-white">{testimonial.message}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

<style>
  .testimonials-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    justify-content: center;
  }
  
  .card {
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 20px 30px -20px rgba(5, 5, 5, 0.24);
    text-align: center;
    backdrop-filter: blur(10px);
    background-color: rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    color: #000; /* Texto negro en modo claro */
  }
  
  .card:hover {
    transform: scale(1.05);
    background-color: rgba(255, 255, 255, 0.2);
  }
  
  .dark .card {
    background-color: rgba(0, 0, 0, 0.1);
    color: #fff; /* Texto blanco en modo oscuro */
  }
  
  .dark .card:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }
  
  .header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .image {
    height: 4rem;
    width: 4rem;
    border-radius: 9999px;
    object-fit: cover;
  }
  
  .stars {
    display: flex;
    justify-content: center;
    gap: 0.125rem;
    color: rgb(204, 175, 7);
  }
  
  .stars svg {
    height: 1rem;
    width: 1rem;
  }
  
  .name {
    margin-top: 0.25rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  
  .message {
    margin-top: 1rem;
  }
  </style>
  

