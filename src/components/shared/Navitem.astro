---
const { href, text, submenu = [] } = Astro.props;
const hasSubmenu = submenu.length > 0;
const id = `submenu-${text.toLowerCase().replace(/\s/g, '-')}`;
---

{hasSubmenu ? (
  <li class="relative">
    <button
      class="nav-toggle-btn inline-flex items-center gap-2 px-4 py-2 hover:text-primary transition-colors"
      data-target={id}
      aria-expanded="false"
    >
      <p  data-translate={text}></p>
  
      <svg class="transition-transform duration-200 nav-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
        <path fill="currentColor" d="m12 10.8l-3.9 3.9q-.275.275-.7.275t-.7-.275q-.275-.275-.275-.7t.275-.7l4.6-4.6q.3-.3.7-.3t.7.3l4.6 4.6q.275.275.275.7t-.275.7q-.275.275-.7.275t-.7-.275z" />
      </svg>
    </button>

    <div
      id={id}
      class="submenu hidden absolute left-0 mt-2 w-56 bg-white dark:bg-black border border-black dark:border-white  rounded-lg shadow-lg z-50"
    >
      <ul class="p-2 flex flex-col gap-2">
        {submenu.map((item: any) => (
          <li>
            <a href={item.href} data-translate={item.href} class="flex items-center gap-2 p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-gray-600 transition-colors">
              {/* <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12 5q-.425 0-.712-.288T11 4V2q0-.425.288-.712T12 1q.425 0 .713.288T13 2v2..." />
              </svg> */}
              <span data-translate={item.text}>{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </li>
) : (
  <li>
    <a
      href={href}
      class="inline-block px-4 py-2 hover:text-primary transition-colors"
      data-translate={text}
    >
      {text}
    </a>
  </li>
)}
