---
import Logocafe from "../../src/assets/images/logocafe.png"
import logodark from "../../src/assets/images/logodark.jpg"
---

<div class="relative mt-16">
  <span
    class="w-20 h-20 rounded-full bg-gradient-to-br from-sky-500 from-0% via-primary via-80% to-green-600 to-110% absolute left-1/3 bottom-1/3"
  ></span>
  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-yellow-400 from-0% via-green-600 via-60% via-sky-700 via-85% to-primary to-100% absolute right-1 top-2/4"
  ></span>
  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-sky-500 from-0% via-primary via-80% to-green-600 to-110% absolute right-1/4 bottom-0"
  ></span>
  <span
    class="w-20 h-20 rounded-full bg-gradient-to-br from-green-500 from-0% via-primary via-80% to-sky-600 to-110% absolute right-1/3 top-1/3"
  ></span>

  <span
    class="w-40 h-40 rounded-full bg-gradient-to-br from-green-500 from-0% via-primary via-80% to-sky-600 to-110% absolute left-0 top-1/3"
  ></span>
  <footer
    class="relative bg-gradient-to-tr from-slate-100/85 to-zinc-200/85 dark:from-slate-800/85 dark:to-zinc-800/85 pt-28 rounded-t-3xl backdrop-blur-md"
  >
    
  

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<footer aria-labelledby="footer-heading" class="relative border-t border-gray-900/10 py-20 mt-10">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="flex items-center justify-center">
          <a href="#" class="-m-1.5 p-1.5 flex items-center justify-center">
            <div class="logo-container">
              <!-- Logo para modo claro -->
              <img class="logo-img block dark:hidden" src={Logocafe.src}alt="logo claro" />
            
              <!-- Logo para modo oscuro -->
              <img class="logo-img hidden dark:block" src={logodark.src} alt="logo oscuro" />
            </div>
            
            
            <style>
              .logo-container {
                width: 80px; /* Tamaño del contenedor */
                height: 80px; /* Igual al ancho para mantener proporción */
                border-radius: 50%; /* Hace que el contenedor sea circular */
                overflow: hidden; /* Oculta las esquinas sobrantes */
                display: flex;
                align-items: center;
                justify-content: center;
              }
            
              .logo-img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* Evita que la imagen se deforme */
              }
            
              /* Ajustes para dispositivos móviles */
              @media (max-width: 768px) { 
                .logo-container {
                  width: 50px;
                  height: 50px;
                }
              }
            </style>
            
            
            <span class="ml-1 text-lg dark:text-white">COFFEE HOUR</span>
          </a>
      </div>
      <div class="mt-16 grid grid-cols-1 gap-8 xl:col-span-2 xl:mt-0">
          <div class="md:grid md:grid-cols-1 md:gap-8">
            <div class="flex justify-evenly">
              <!-- <div>
                <a href="https://wa.me/523329173286" target="_blank" class="text-md leading-6 text-green-600 hover:text-gray-900 flex items-center">
                  <i class="fab fa-whatsapp mr-2 text-green-500"></i>Whatsapp
                </a>
              </div> -->
              <div>
                <a href="https://www.instagram.com/coffeehour_chapala?igsh=bmoxeXA3eGM4OHNp" target="_blank" class="text-md leading-6 text-pink-600 hover:text-gray-900 flex items-center">
                  <i class="fab fa-instagram mr-2 text-pink-500"></i>Instagram
                </a>
              </div>
              <div>
                <a href="https://www.facebook.com/CoffeeHourChapala?mibextid=wwXIfr&mibextid=wwXIfr" target="_blank" class="text-md leading-6 text-blue-600 hover:text-gray-900 flex items-center">
                  <i class="fab fa-facebook mr-2 text-blue-600"></i>Facebook
                </a>
              </div>
            </div>
            
          </div>
      </div>
  </div>
</footer>

<div class="p-4 from-box-bg lg:px-20 sm:px-2 relative">
  <div class="flex justify-between items-center gap-6 text-sm color-[#ffffffb5]">
      <div class="dark:text-white">
          &copy; <span id="year" class="dark:text-white"></span>COFFEE HOUR
      </div>
      <div class="dark:text-white">
          Hecho por <a href="https://udigitalbusiness.com/" class="font-semibold" target="blank">UDigital Business</a>
      </div>
  </div>
</div>